# Runtime
NODE_ENV=development
API_PORT=3001
FRONTEND_PORT=5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Live integrations only. Missing contracts fail closed.
PAYMENT_MODE=live
FUNDING_MODE=manual
PAYOUT_MODE=live

# Live model configuration
OPENAI_API_KEY=
OPENAI_MODEL=
APP_ACCESS_CODE=

# Pollar browser SDK configuration. Publishable key only.
POLLAR_PUBLISHABLE_KEY=
POLLAR_NETWORK=testnet

# Required before PAYMENT_MODE=live can start. Values must come from the
# organizer's supported Stellar x402 contract; do not infer them.
X402_FACILITATOR_URL=
X402_NETWORK=
X402_ASSET_ID=
X402_ASSET_DECIMALS=

