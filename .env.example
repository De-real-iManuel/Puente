# Runtime
NODE_ENV=development
API_PORT=3001
FRONTEND_PORT=5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Integration modes
PAYMENT_MODE=live
FUNDING_MODE=manual
PAYOUT_MODE=fixture

# Live model configuration (server-only secrets)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
APP_ACCESS_CODE=

# Operator endpoint secret (min 32 chars, server-only)
OPERATOR_SECRET=

# Pollar browser SDK — publishable key only, safe to expose via /api/pollar/config
POLLAR_PUBLISHABLE_KEY=
POLLAR_NETWORK=testnet

# Stellar x402 — OpenZeppelin/Pollar testnet facilitator
# Network: stellar:testnet
# USDC asset on Stellar testnet: CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Receiver wallet: a Stellar testnet address that has a USDC trustline
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_NETWORK=stellar:testnet
X402_ASSET_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
X402_ASSET_DECIMALS=7
X402_PAY_TO=
